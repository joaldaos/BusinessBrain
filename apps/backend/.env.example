# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# De dónde se sirve la interfaz. OBLIGATORIA en producción: es el único origen al que se le
# permite hablar con la API desde el navegador de un cliente. Sin ella el arranque falla, a
# propósito — antes se aceptaba cualquier origen y olvidarla no rompía nada.
FRONTEND_URL=http://localhost:5173

# ── Base de datos (docker-compose.yml de la raíz) ──────────────────────────
DATABASE_URL=postgresql://businessbrain:businessbrain@localhost:5432/businessbrain?schema=public
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string-in-production
JWT_REFRESH_EXPIRATION=30d

# ── Cifrado de secretos en reposo (AES-256-GCM) ────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Correo saliente ────────────────────────────────────────────────────────
# Hoy se manda una sola cosa: el enlace para recuperar la contraseña. SIN ESTO NO SALE NADA
# y quien olvide su contraseña se queda fuera.
#
# URL de conexión SMTP completa. Vale cualquier proveedor: el correo corporativo que ya
# tenga la empresa, un servicio transaccional, o el propio hosting.
#   smtps://usuario:clave@smtp.tuproveedor.com:465     (TLS directo, lo habitual)
#   smtp://usuario:clave@smtp.tuproveedor.com:587      (STARTTLS)
#
# ES UN SECRETO: lleva la contraseña del buzón. Va en el gestor de secretos del despliegue,
# nunca en el repositorio.
SMTP_URL=
# Remitente. Obligatorio si hay SMTP_URL.
MAIL_FROM=BusinessBrain <no-reply@tuempresa.com>

# ── Alertas operativas ─────────────────────────────────────────────────────
# Canal interno donde avisar de que algo se ha roto (sincronización, análisis).
# Cualquier URL que acepte POST {"text": "..."} — el formato de Slack y Mattermost.
# Sin ella, las alertas van al registro del servidor: menos cómodo, pero no silencioso.
# Solo salen identificadores, nunca nombres ni mensajes de error: pueden llevar dentro
# el título de un documento del cliente.
ALERTS_WEBHOOK_URL=

# ── Proveedores LLM de plataforma (fallback si una organización no trae su propia key) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
