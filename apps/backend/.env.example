# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Base de datos (docker-compose.yml de la raíz) ──────────────────────────
DATABASE_URL=postgresql://businessbrain:businessbrain@localhost:5432/businessbrain?schema=public
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string-in-production
JWT_REFRESH_EXPIRATION=30d

# ── Cifrado de secretos en reposo (AES-256-GCM) ────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Proveedores LLM de plataforma (fallback si una organización no trae su propia key) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
