node_modules/
dist/
.env
*.local
.DS_Store
coverage/

# Artefacto incremental de TypeScript: no es codigo fuente.
apps/web/tsconfig.tsbuildinfo

# Resultados y trazas de Playwright: artefactos, no codigo fuente.
apps/web/test-results/
apps/web/playwright-report/

# Copias de seguridad: llevan los documentos de todos los clientes en claro.
backups/

# Ajustes locales de la herramienta, no del producto.
# Se excluye el CONTENIDO, no el directorio: git no puede reincluir un fichero que está
# dentro de un directorio excluido, y las reglas de permisos del proyecto sí se comparten.
.claude/*
# `settings.local.json` no se comparte: es de cada persona y acumula rutas de su máquina.
!.claude/settings.json
