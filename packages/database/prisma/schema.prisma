// packages/database/prisma/schema.prisma
//
// Fuente de verdad: docs/BUSINESSBRAIN_MIGRATION_PLAN.md §6 (aprobado, congelado) para todo
// modelo que no sea del Knowledge Engine. Para KnowledgeSource, IngestionJob, KnowledgeItem,
// KnowledgeCollection y KnowledgeChunk, la fuente de verdad es docs/KNOWLEDGE_ENGINE_DESIGN.md
// (Arquitectura Congelada), que reemplaza y profundiza el §6-7 de aquel documento. Cualquier
// cambio de modelo pasa primero por el documento correspondiente — no se edita aquí de forma
// independiente. Los modelos del Knowledge Engine se migran de forma incremental, una subfase
// del roadmap (§19 de KNOWLEDGE_ENGINE_DESIGN.md) a la vez — ver ese documento para el estado
// de cada subfase.
//
// Vive en un paquete de workspace propio (no dentro de apps/backend) para que
// futuros workers o servicios (ver roadmap, fase de extracción de microservicios)
// puedan depender del mismo cliente Prisma sin duplicar el schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum PlatformRole {
  USER
  SUPERADMIN
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum KnowledgeSourceType {
  FILE_UPLOAD
  WEBSITE
  GOOGLE_DRIVE
  GMAIL
  CRM
  ERP
  DATABASE
  SOCIAL_MEDIA
  API
}

// Reutilizado por KnowledgeSource e Integration (ambos son "conexiones" a sistemas externos)
enum ConnectionStatus {
  PENDING
  SYNCING
  CONNECTED
  ERROR
  DISABLED
}

// Origen de una clasificación — KNOWLEDGE_ENGINE_DESIGN.md §9 "Asignación", §3.8.
// Una corrección manual es pegajosa: un reprocesamiento automático posterior NO la
// sobrescribe salvo confirmación explícita del usuario.
enum ClassificationSource {
  AUTOMATIC
  MANUAL
}

// Qué disparó un recálculo de confianza — KNOWLEDGE_ENGINE_DESIGN.md §8.2, §8.4.
// La confianza es auditable: no solo su valor actual, también su historia y el motivo
// de cada cambio.
enum ConfidenceEventType {
  INITIAL // cálculo al indexar (§8.1)
  TEMPORAL_DECAY // barrido periódico de envejecimiento (§8.3)
  SOURCE_DISCONNECTED // la KnowledgeSource de origen entró en ERROR o se deshabilitó (§8.2)
  MANUAL_OVERRIDE // curación humana: fijación explícita del score (§8.2)
  MANUAL_REVOKED // se revoca una fijación manual y el ítem vuelve al cálculo automático
}

// Ciclo de vida de un BusinessObjective — UNDERSTANDING_ENGINE_DESIGN.md §3.6.
// La VIGENCIA no es un estado: se deriva de ser la version mas reciente de la cadena
// UPDATES. Una version predecesora conserva el estado que tenia entonces, como registro
// historico honesto de que se confirmo y cuando.
enum BusinessObjectiveStatus {
  INFERRED // candidato propuesto por el sistema; NO puede sostener un RISK/OPPORTUNITY
  CONFIRMED // respaldado por una persona: unico estado que habilita un juicio de valor (§8)
  DISCARDED // rechazado explicitamente
}

// De donde nace una version de BusinessObjective. Determina el estado de la version nueva
// al versionarse (§3.6): una edicion manual conserva CONFIRMED; una re-inferencia
// automatica nace siempre INFERRED, aunque reemplace a una version confirmada.
enum BusinessObjectiveOrigin {
  MANUAL_DECLARATION
  AUTOMATIC_INFERENCE
}

// Estado de resolución de un Canonical Knowledge Entity — KNOWLEDGE_ENGINE_DESIGN.md §10.
enum CanonicalResolutionStatus {
  RESOLVED // hay un ganador claro: diferencia de score por encima del umbral
  IN_CONFLICT // empate o diferencia insuficiente: NO se resuelve automáticamente (§10)
}

// Por qué un candidato fue vinculado al grupo (§10, "Cómo se agrupan los candidatos").
enum CanonicalCandidateOrigin {
  SEMANTIC_DEDUPLICATION // detectado por el nivel 3 de deduplicación (§7) — operativo desde 2.6
  MANUAL_LINK // un usuario vinculó dos documentos: "estos hablan de lo mismo"
}

enum IngestionTriggerType {
  MANUAL
  SCHEDULE
  EVENT
}

// KNOWLEDGE_ENGINE_DESIGN.md §3.5: PENDING/PROCESSING/INDEXED son estados activos; SUPERSEDED/
// FAILED/DELETED son terminales. Todo valor nuevo que se añada aquí debe clasificarse
// explícitamente en apps/backend/src/knowledge-engine/domain/knowledge-item-status.classification.ts
// — un valor sin clasificar hace fallar ese test en CI (regla arquitectónica de §3.5).
enum KnowledgeItemStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
  SUPERSEDED // reemplazado por una versión más reciente del mismo KnowledgeItem (§6)
  DELETED // baja lógica — KNOWLEDGE_ENGINE_DESIGN.md §5, no implementado todavía en Fase 2.1
}

// Grafo de linaje de KnowledgeItem — KNOWLEDGE_ENGINE_DESIGN.md §3.7, §6. Nombres en inglés para
// consistencia con el resto de enums del schema; corresponden 1:1 a los términos en español del
// documento de diseño: UPDATES=ACTUALIZA, SPLIT_FROM=DIVIDIDO_DESDE, MERGED_FROM=FUSIONADO_DESDE,
// DUPLICATE_OF=DUPLICADO_DE, RESTORED_FROM=RESTAURADO_DESDE.
enum KnowledgeItemLineageEdgeType {
  UPDATES
  SPLIT_FROM
  MERGED_FROM
  DUPLICATE_OF
  RESTORED_FROM
}

enum LlmProviderName {
  ANTHROPIC
  OPENAI
  GEMINI
  MISTRAL
  OLLAMA
}

enum AgentTemplateVisibility {
  PRIVATE // solo la organización que la creó
  ORGANIZATION // compartida entre agentes de la misma organización
  PUBLIC // catálogo del marketplace (futuro)
}

enum AgentArea {
  SALES
  MARKETING
  SUPPORT
  OPERATIONS
  FINANCE
  HR
  GENERAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AutomationTriggerType {
  SCHEDULE
  EVENT
  MANUAL
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ReportFormat {
  PDF
  HTML
  MARKDOWN
  JSON
}

enum RecommendationStatus {
  NEW
  ACCEPTED
  DISMISSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum IntegrationProvider {
  HUBSPOT
  SALESFORCE
  GOOGLE_DRIVE
  GMAIL
  SLACK
  SAP
  ZENDESK
  CUSTOM
}

// ─────────────────────────────────────────────────────────────────────────
// Identidad y multi-tenancy
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  platformRole PlatformRole @default(USER)
  status       String       @default("ACTIVE") // ACTIVE | BANNED
  /// Idioma elegido por la persona para la INTERFAZ y para las respuestas del chat.
  ///
  /// No dice nada sobre el idioma de los documentos de la empresa: son cosas independientes
  /// y el producto seria inservible si exigiera que coincidieran.
  ///
  /// Texto y no un enum a proposito: anadir frances tiene que ser una entrada en una lista de
  /// codigo y un fichero de traducciones, no una migracion de esquema. Quien valida es
  /// `common/i18n/locales.ts`. Nulo = no ha elegido, y se usa el idioma del navegador.
  locale       String?
  lastActiveAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships      Membership[]
  conversations    Conversation[]
  agentMemories    AgentMemory[]
  notifications    Notification[]
  auditLogsAsActor AuditLog[]     @relation("AuditActor")
  createdApiKeys   ApiKey[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]

  // Accesos administrativos a datos de clientes: pedidos, aprobados o retirados por esta
  // persona. Nunca son membresias — ver PlatformAccessGrant.
  platformGrantsRequested PlatformAccessGrant[] @relation("PlatformGrantRequester")
  platformGrantsApproved  PlatformAccessGrant[] @relation("PlatformGrantApprover")
  platformGrantsRevoked   PlatformAccessGrant[] @relation("PlatformGrantRevoker")

  // Decisiones humanas sobre propuestas (subfase 5.8) y concesiones de acceso otorgadas.
  resolvedRecommendations Recommendation[]            @relation("RecommendationResolver")
  authoredRecommendations Recommendation[]            @relation("RecommendationAuthor")
  grantedCollectionAccess KnowledgeCollectionAccess[] @relation("CollectionAccessGrantedBy")

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Recuperación de contraseña.
///
/// Se guarda el HMAC del testigo, nunca el testigo: quien consiguiera leer esta tabla no podría
/// entrar en ninguna cuenta sin conocer además el secreto de la aplicación. Es el mismo trato
/// que reciben los tokens de refresco, y por la misma razón.
///
/// `usedAt` en vez de borrar la fila: un testigo usado tiene que poder distinguirse de uno que
/// nunca existió, tanto para rechazarlo con certeza como para poder mirar después si alguien
/// estuvo pidiendo recuperaciones que no eran suyas.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Que puede ver la administracion de BusinessBrain de una empresa concreta.
///
/// Los tres alcances son INDEPENDIENTES: ninguno arrastra a otro. Tener METADATA no abre
/// DIAGNOSTICS ni CONTENT, y CONTENT tampoco arrastra los otros dos. Cada concesion lleva su
/// propio motivo, su propia caducidad y su propia traza.
enum PlatformAccessScope {
  /// Nombres, contadores y estados. Nunca contenido.
  METADATA
  /// Errores de ingesta y trazas de fallo, para poder investigar una incidencia.
  DIAGNOSTICS
  /// Titulos y texto de documentos. Exige aprobacion explicita del propietario.
  CONTENT
}

/// Ciclo de vida de una concesion.
///
/// NO existe un estado CADUCADA: la caducidad se deriva de `expiresAt` en cada comprobacion.
/// Un estado almacenado exigiria un proceso que lo actualizara, y entre que caduca y ese
/// proceso pasa habria una ventana en la que el acceso seguiria abierto. Derivarla del reloj
/// no tiene ventana.
enum PlatformAccessStatus {
  /// Pedida y esperando al propietario. Solo CONTENT nace asi.
  PENDING
  /// Utilizable, mientras no caduque ni se revoque.
  ACTIVE
  /// Retirada antes de tiempo, por quien la pidio o por quien la aprobo.
  REVOKED
}

/// Acceso administrativo a los datos de UNA empresa, motivado, acotado y caducable.
///
/// ## Por que NO cuelga de una Membership
///
/// `KnowledgeCollectionAccess` —la otra concesion del sistema— cuelga de la membresia, para
/// que salir de la organizacion revoque en cascada lo concedido. Aqui seria imposible: quien
/// administra la plataforma **no tiene ni puede tener membresia**. Colgar de `User` y
/// `Organization` por separado es lo que hace que una concesion no pueda convertirse nunca en
/// pertenencia: son dos tablas de forma distinta y no hay manera de confundirlas.
///
/// ## Por que la caducidad es obligatoria y no admite nulo
///
/// Un permiso sin fecha de fin es un permiso permanente con otro nombre. La columna es NOT
/// NULL a proposito: no existe forma de escribir una concesion indefinida, ni por error ni a
/// proposito.
model PlatformAccessGrant {
  id             String               @id @default(cuid())
  organizationId String
  scope          PlatformAccessScope
  status         PlatformAccessStatus @default(ACTIVE)

  /// Por que se pide. Obligatorio: un acceso sin motivo no se puede auditar despues.
  reason String

  /// Quien pide el acceso. La concesion es SUYA: otra cuenta de plataforma no la hereda, y
  /// eso es lo que impide que un futuro asistente reutilice una concesion ajena.
  requestedById String
  createdAt     DateTime @default(now())

  /// Quien la aprobo. Solo CONTENT lo exige; en los demas alcances queda nulo.
  approvedById String?
  approvedAt   DateTime?

  /// Quien la retiro antes de tiempo, y cuando.
  revokedById String?
  revokedAt   DateTime?

  /// Cuando deja de servir. Siempre presente.
  expiresAt DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("PlatformGrantRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("PlatformGrantApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  revokedBy    User?        @relation("PlatformGrantRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([organizationId, scope, status])
  @@index([requestedById])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  planTier  PlanTier @default(FREE)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  invitations               Invitation[]
  subscription              Subscription?
  knowledgeSources          KnowledgeSource[]
  knowledgeItems            KnowledgeItem[]
  knowledgeCollections      KnowledgeCollection[]
  knowledgeItemLineageEdges KnowledgeItemLineageEdge[]
  taxonomyNodes             TaxonomyNode[]
  agents                    Agent[]
  agentMemories             AgentMemory[]
  agentTemplates            AgentTemplate[] // plantillas publicadas por esta organización (si visibility != PRIVATE)
  llmProfiles               LlmProfile[]
  conversations             Conversation[]
  automations               Automation[]
  reports                   Report[]
  integrations              Integration[]
  apiKeys                   ApiKey[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  recommendations           Recommendation[]
  canonicalEntities         CanonicalKnowledgeEntity[]
  businessObjectives        BusinessObjective[]
  analysisRuns              AnalysisRun[]
  insights                  Insight[]
  usageRecords              UsageRecord[]
  platformAccessGrants      PlatformAccessGrant[]

  @@index([slug])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  invitedById    String?
  joinedAt       DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Colecciones concedidas a esta persona EN ESTA organizacion (subfase 5.8). Cuelgan de la
  // membresia para que la baja las revoque en cascada.
  collectionAccess KnowledgeCollectionAccess[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole @default(MEMBER)
  token          String         @unique
  createdById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Subscription {
  id                            String             @id @default(cuid())
  organizationId                String             @unique
  planTier                      PlanTier
  status                        SubscriptionStatus
  paymentProviderCustomerId     String?
  paymentProviderSubscriptionId String?
  seats                         Int                @default(1)
  currentPeriodEnd              DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// KNOWLEDGE ENGINE — núcleo del producto
// KnowledgeSource → IngestionJob → KnowledgeItem (versionado, dedup, confianza) → KnowledgeChunk
// ─────────────────────────────────────────────────────────────────────────

model KnowledgeSource {
  id             String              @id @default(cuid())
  organizationId String
  type           KnowledgeSourceType
  connectorKey   String // identifica la implementación del conector, p.ej. "file_upload_v1"
  name           String
  configEnc      String // JSON cifrado: credenciales/config específica del conector
  status         ConnectionStatus    @default(PENDING)
  lastSyncedAt   DateTime?
  lastError      String?
  // Conexion externa que autoriza esta fuente. Nula en las que no la necesitan (subida
  // manual, pagina web publica). Relacion INEQUIVOCA: al revocar la conexion se sabe
  // exactamente que fuentes dejan de poder sincronizar.
  integrationId  String?
  // Marcador de la ultima sincronizacion, propiedad del conector: donde se quedo. Para Drive
  // es el token de cambios de Google. No es un secreto —no da acceso a nada— y por eso no
  // viaja en `configEnc`, que se descifra entero en cada uso.
  syncCursor     Json?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Dos relaciones distintas y no intercambiables a KnowledgeItem — ver KNOWLEDGE_ENGINE_DESIGN.md
  // §3.5 (procedencia inmutable vs. ubicación actual mutable), corrección de la auditoría previa
  // a la congelación, hallazgo #1.
  knowledgeItemsAsOrigin  KnowledgeItem[] @relation("KnowledgeItemOriginSource")
  knowledgeItemsAsCurrent KnowledgeItem[] @relation("KnowledgeItemCurrentSource")
  ingestionJobs           IngestionJob[]
  collections             KnowledgeSourceCollection[]
  integration             Integration?    @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: SetNull)

  @@unique([id, organizationId])
  @@index([organizationId])
}

// A que colecciones va a parar el conocimiento que entra por una fuente.
//
// Sin esto, un documento recien ingerido no pertenecia a ninguna coleccion, su alcance
// efectivo era vacio y —por la regla fail-closed de alcance vacio— NADIE podia ver la
// comprension derivada de el. El sistema funcionaba y no servia para nada.
//
// Es el "alcance" que KNOWLEDGE_ENGINE_DESIGN.md §3.2 ya atribuye a una KnowledgeSource:
// que carpeta, que buzon, que tablas. Aqui, a que coleccion pertenece lo que traiga.
model KnowledgeSourceCollection {
  knowledgeSourceId     String
  knowledgeCollectionId String
  organizationId        String

  knowledgeSource     KnowledgeSource     @relation(fields: [knowledgeSourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  knowledgeCollection KnowledgeCollection @relation(fields: [knowledgeCollectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([knowledgeSourceId, knowledgeCollectionId])
  @@index([organizationId])
}

// Una fila por cada ejecución de sincronización de una KnowledgeSource — antes solo existía
// como campo de estado en la fuente, sin histórico ni estadísticas por ejecución.
model IngestionJob {
  id                String               @id @default(cuid())
  knowledgeSourceId String
  organizationId    String
  triggerType       IngestionTriggerType @default(MANUAL)
  status            RunStatus            @default(PENDING)
  stats             Json                 @default("{}") // { itemsFound, itemsCreated, itemsUpdated, itemsSkippedDuplicate, itemsFailed }
  error             String?
  startedAt         DateTime             @default(now())
  finishedAt        DateTime?

  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  knowledgeItems  KnowledgeItem[]

  @@index([knowledgeSourceId])
  @@index([organizationId])
}

model KnowledgeCollection {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  description    String?
  area           AgentArea?
  createdAt      DateTime   @default(now())

  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeItemCollections KnowledgeItemCollection[]
  knowledgeSources         KnowledgeSourceCollection[]
  agents                   Agent[]                     @relation("AgentKnowledgeScope")
  userAccess               KnowledgeCollectionAccess[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

// Acceso de una PERSONA a una coleccion de conocimiento (subfase 5.8).
//
// Hasta aqui el alcance de coleccion solo existia para agentes (`AgentKnowledgeScope`). El
// Understanding Engine, en cambio, acota la comprension —y las `Recommendation` derivadas de
// ella— por `EffectiveCollectionScope` (UNDERSTANDING_ENGINE_DESIGN.md §3.4, §12), y esa
// regla se compara contra las colecciones a las que el CONSUMIDOR tiene acceso concedido.
// Sin este modelo, ese consumidor no podia ser una persona: no habia forma de expresar que
// alguien tiene acceso a Ventas pero no a RR. HH., asi que una `Recommendation` sostenida
// por evidencia restringida habria sido visible para cualquier miembro de la organizacion.
//
// El acceso se concede, NUNCA se presupone: no tener ninguna fila aqui significa no tener
// acceso a ninguna coleccion, no a todas (KNOWLEDGE_ENGINE_DESIGN.md §535).
model KnowledgeCollectionAccess {
  id                    String   @id @default(cuid())
  organizationId        String
  knowledgeCollectionId String
  userId                String
  grantedById           String?
  createdAt             DateTime @default(now())

  // La concesion cuelga de la MEMBRESIA, no del usuario suelto: salir de la organizacion
  // revoca en cascada todo lo concedido en ella. Un acceso que sobreviviera a la baja seria
  // exactamente el permiso que nadie recuerda retirar.
  membership Membership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  // FK COMPUESTA contra (id, organizationId) de la coleccion: hace imposible por
  // construccion conceder una coleccion de otra organizacion. Comprobarlo solo en el
  // servicio dejaria la garantia a merced de la siguiente via de escritura que se anada.
  knowledgeCollection KnowledgeCollection @relation(fields: [knowledgeCollectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  grantedBy User? @relation("CollectionAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([knowledgeCollectionId, userId])
  @@index([organizationId, userId])
  @@index([userId])
}

// Fase 2.1 (KNOWLEDGE_ENGINE_DESIGN.md §19, subfase 2.1): solo ingesta + normalización básica.
// Sin campos de clasificación/confianza/versionado/canonicalización todavía — llegan en las
// subfases 2.2-2.5, cada una con su propia migración acotada. `chunks` queda declarado pero sin
// uso hasta su subfase correspondiente (2.6).
model KnowledgeItem {
  id             String @id @default(cuid())
  organizationId String

  // Procedencia — inmutable, fijada en la creación, nunca se actualiza tras el alta. Ubicación
  // actual — mutable (en Fase 2.1 siempre coincide con la procedencia: la operación de "mover"
  // de §6 no se construye todavía). KNOWLEDGE_ENGINE_DESIGN.md §3.5, corrección de la auditoría
  // previa a la congelación, hallazgo #1.
  originKnowledgeSourceId  String?
  originIngestionJobId     String?
  currentKnowledgeSourceId String?

  title       String
  sourceUrl   String?
  mimeType    String?
  sizeBytes   Int?
  contentText String // contenido normalizado — KNOWLEDGE_ENGINE_DESIGN.md §4 "Normalización"
  contentHash String // hash del contenido normalizado; base de la deduplicación (§7)
  // Lo que la fuente nos dijo y NO es conocimiento.
  //
  // Existe para poder separar las dos cosas de forma tajante: `contentText` es lo que se
  // indexa, se trocea, se vectoriza y se recupera; esto es metadata OPERATIVA que sirve para
  // sincronizar, agrupar o trazar y que nunca debe acabar en un embedding ni en un informe.
  //
  // Es un contenedor generico, no de un conector concreto: hoy guarda el hilo de un correo y
  // la direccion de su remitente —dato personal que por decision de producto no entra en el
  // conocimiento recuperable—, y manana lo que necesite otra fuente.
  sourceMetadata Json?

  status    KnowledgeItemStatus @default(PENDING)
  // El documento ya no esta en la fuente sincronizada que lo trajo.
  //
  // NO es un estado del ciclo de vida, y por eso no entra en `KnowledgeItemStatus`: el item
  // sigue siendo conocimiento valido, con su contenido, su linaje y sus versiones intactos.
  // Es un ATRIBUTO que cambia sobre el mismo item sin crear version, exactamente como la
  // clasificacion, la confianza o la pertenencia a colecciones — §5 lo permite explicitamente.
  //
  // Se distingue de ELIMINADO porque ELIMINADO es una decision humana o administrativa; esto
  // es una OBSERVACION del sincronizador. Sacar un fichero de la carpeta vigilada es
  // indistinguible de borrarlo, asi que el sistema informa y no decide.
  //
  // Nulo = presente en su origen, o el origen no permite saberlo (subida manual).
  sourceMissingSince DateTime?
  error     String?
  createdAt DateTime            @default(now())
  indexedAt DateTime?

  // ── Clasificación (§3.8, §9) — subfase 2.3 ──────────────────────────────
  // Categoría principal: un ítem pertenece a UN solo nodo de la taxonomía, siempre el
  // más específico posible. La pertenencia implica los ancestros de forma implícita.
  taxonomyNodeId          String?
  // Área de negocio derivada, para compatibilidad con el alcance de agentes (§9).
  businessArea            AgentArea?
  // Etiquetas libres, no jerárquicas (§9 "Etiquetas").
  tags                    String[]              @default([])
  // Certeza del propio proceso de clasificación. Insumo directo del confidence score
  // (§8.1) y señal de contenido heterogéneo para el refinamiento por chunk (§9, §3.6).
  classificationCertainty Float?
  classificationSource    ClassificationSource?
  classifiedAt            DateTime?

  // ── Confianza (§3.9, §8.1) — subfase 2.3: solo el cálculo inicial ───────
  // Score normalizado [0,1]. Valor VIVO: en 2.4 se le añaden decaimiento y recálculo
  // por evento; aquí solo nace.
  // Fijación manual (§8.2, "Curación humana"): tiene PRIORIDAD sobre cualquier recálculo
  // automático hasta que se revoca explícitamente. El decaimiento no la toca.
  confidenceIsManual   Boolean   @default(false)
  confidenceManualById String?
  confidenceManualAt   DateTime?

  confidenceScore      Float?
  // Factores que lo componen, visibles y auditables — la confianza es explicable, no
  // solo un número (§8.4: "auditable, no solo el número actual sino su historia").
  confidenceFactors    Json?
  confidenceComputedAt DateTime?

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originKnowledgeSource    KnowledgeSource?           @relation("KnowledgeItemOriginSource", fields: [originKnowledgeSourceId], references: [id], onDelete: SetNull)
  originIngestionJob       IngestionJob?              @relation(fields: [originIngestionJobId], references: [id], onDelete: SetNull)
  currentKnowledgeSource   KnowledgeSource?           @relation("KnowledgeItemCurrentSource", fields: [currentKnowledgeSourceId], references: [id], onDelete: SetNull)
  taxonomyNode             TaxonomyNode?              @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  confidenceEvents         ConfidenceEvent[]
  canonicalMemberships     CanonicalCandidate[]
  canonicalEntitiesWon     CanonicalKnowledgeEntity[] @relation("CanonicalWinner")
  knowledgeItemCollections KnowledgeItemCollection[]
  chunks                   KnowledgeChunk[]
  // Grafo de linaje (§3.7, §6): "From" es el ítem que narra la relación (el nuevo/el duplicado/el
  // restaurado), "To" es el ítem de destino (el reemplazado/el principal/el estado eliminado
  // previo) — dirección fijada por cada escenario de §6, no simétrica.
  lineageEdgesAsFrom       KnowledgeItemLineageEdge[] @relation("LineageEdgeFrom")
  lineageEdgesAsTo         KnowledgeItemLineageEdge[] @relation("LineageEdgeTo")

  @@index([organizationId])
  @@index([originKnowledgeSourceId])
  @@index([currentKnowledgeSourceId])
  @@index([organizationId, contentHash]) // lookup rápido de duplicados por organización (§7, desde subfase 2.2)
  @@index([taxonomyNodeId])
  @@index([organizationId, businessArea]) // alcance de agentes por área (§9)
  // Barrido de decaimiento (§8.3): recorre ítems activos por fecha de último cálculo.
  @@index([organizationId, confidenceComputedAt])
}

// Historial de la confianza — KNOWLEDGE_ENGINE_DESIGN.md §8.4: "Cada recálculo queda
// registrado con la fecha y el factor que lo disparó — la confianza es auditable, no solo
// el número actual sino su historia". Registro de solo-anexado: nunca se edita ni se borra.
model ConfidenceEvent {
  id              String @id @default(cuid())
  organizationId  String
  knowledgeItemId String

  type          ConfidenceEventType
  previousScore Float?
  newScore      Float
  // Factores que compusieron el nuevo score, o el motivo de la fijación manual.
  detail        Json
  actorUserId   String?
  createdAt     DateTime            @default(now())

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId, createdAt])
  @@index([organizationId])
}

// Pertenencia N:M de un KnowledgeItem a una o más KnowledgeCollection — KNOWLEDGE_ENGINE_DESIGN.md
// §3.4 exige N:M ("un mismo KnowledgeItem puede pertenecer a más de una colección"); la subfase 2.1
// lo había modelado por error como N:1 (`KnowledgeItem.knowledgeCollectionId` escalar). Corrección
// de la Revisión formal — Subfase 2.2, hallazgo A, aplicada como prerrequisito de esta subfase.
model KnowledgeItemCollection {
  id                    String   @id @default(cuid())
  knowledgeItemId       String
  knowledgeCollectionId String
  organizationId        String
  createdAt             DateTime @default(now())

  knowledgeItem       KnowledgeItem       @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  knowledgeCollection KnowledgeCollection @relation(fields: [knowledgeCollectionId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, knowledgeCollectionId])
  @@index([knowledgeCollectionId])
  @@index([organizationId])
}

// Grafo de linaje de conocimiento — KNOWLEDGE_ENGINE_DESIGN.md §3.7, §6. Solo-anexado: ninguna
// arista se edita ni se borra nunca (aplicado a nivel de aplicación; no hay UPDATE/DELETE sobre
// esta tabla en ningún caso de uso). Subfase 2.2 dispara automáticamente `UPDATES` desde el
// pipeline de ingesta (nivel 2 de deduplicación, §7); `SPLIT_FROM`/`MERGED_FROM` quedan
// disponibles como capacidad de dominio para disparo manual/explícito (§20), sin superficie de
// API dedicada todavía; `DUPLICATE_OF` (detección retroactiva) y `RESTORED_FROM` (depende de un
// flujo de eliminación no construido todavía) quedan solo como tipo de arista disponible.
model KnowledgeItemLineageEdge {
  id                  String                       @id @default(cuid())
  organizationId      String
  fromKnowledgeItemId String
  toKnowledgeItemId   String
  type                KnowledgeItemLineageEdgeType
  createdAt           DateTime                     @default(now())

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromKnowledgeItem KnowledgeItem @relation("LineageEdgeFrom", fields: [fromKnowledgeItemId], references: [id], onDelete: Cascade)
  toKnowledgeItem   KnowledgeItem @relation("LineageEdgeTo", fields: [toKnowledgeItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([fromKnowledgeItemId])
  @@index([toKnowledgeItemId])
}

model KnowledgeChunk {
  id              String                      @id @default(cuid())
  knowledgeItemId String
  organizationId  String
  chunkIndex      Int
  content         String
  tokenCount      Int?
  metadata        Json                        @default("{}")
  embedding       Unsupported("vector(1536)")
  createdAt       DateTime                    @default(now())

  // Modelo y versión que generaron el vector — OBLIGATORIO, no opcional
  // (KNOWLEDGE_ENGINE_DESIGN.md §3.11, §12): vectores de modelos distintos no son
  // comparables entre sí y nunca deben mezclarse en una misma búsqueda de similitud.
  embeddingModel   String
  embeddingVersion String

  // Hash del contenido canónico del fragmento (§3.12). Permite reutilizar el CÓMPUTO del
  // vector cuando un fragmento idéntico ya fue vectorizado (§7, "duplicados parciales") —
  // se evita la llamada al proveedor, nunca se comparte el registro Embedding: cada chunk
  // conserva el suyo (§3.11, hallazgo #4 de la auditoría).
  contentHash String

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  // Índice HNSW sobre `embedding` creado vía migración SQL manual:
  // CREATE INDEX ON "KnowledgeChunk" USING hnsw (embedding vector_cosine_ops);

  // Un KnowledgeItem no puede tener dos fragmentos en la misma posición.
  @@unique([knowledgeItemId, chunkIndex])
  @@index([organizationId])
  @@index([knowledgeItemId])
  // Cache de cómputo de vectores por contenido idéntico dentro de la organización (§7).
  @@index([organizationId, contentHash, embeddingModel])
}

// ─────────────────────────────────────────────────────────────────────────
// Conversación — superficie de consumo del Knowledge Engine (NO es el núcleo)
// ─────────────────────────────────────────────────────────────────────────

model Conversation {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  agentId        String?
  title          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([organizationId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json? // [{ knowledgeItemId, chunkId, snippet }]
  tokenCount     Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Agentes especializados por área — más que un prompt: capacidades, herramientas,
// memoria, permisos, políticas y alcance de conocimiento explícitos
// ─────────────────────────────────────────────────────────────────────────

model Agent {
  id             String    @id @default(cuid())
  organizationId String
  templateId     String? // si se instaló desde un AgentTemplate (groundwork de marketplace)
  name           String
  area           AgentArea @default(GENERAL)
  systemPrompt   String
  llmProfileId   String? // proveedor/modelo (ver LlmProfile) — null = usa el perfil por defecto de la organización
  temperature    Float? // override puntual; si es null se usa el de LlmProfile
  capabilities   Json      @default("[]") // habilidades de alto nivel: ["answer_questions", "generate_report", "trigger_automation"]
  tools          Json      @default("[]") // [{ tool: "sql_query", permission: "READ_ONLY" }, { tool: "send_email", permission: "REQUIRES_CONFIRMATION" }]
  memoryConfig   Json      @default("{}") // { strategy: "short_term" | "long_term" | "none", windowSize }
  guardrails     Json      @default("{}") // políticas: límites de acción, reglas de escalado a un humano, temas prohibidos
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template             AgentTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  llmProfile           LlmProfile?           @relation(fields: [llmProfileId], references: [id], onDelete: SetNull)
  knowledgeCollections KnowledgeCollection[] @relation("AgentKnowledgeScope")
  conversations        Conversation[]
  recommendations      Recommendation[]
  memories             AgentMemory[]

  @@index([organizationId])
}

// Memoria persistente del agente, independiente del historial de una conversación concreta
// (p. ej. "el cliente X prefiere que se le contacte por email", aprendido en una conversación
// y reutilizable en cualquier interacción futura con ese agente).
// La memoria es PRIVADA DE CADA USUARIO, no de la organización. Las conversaciones ya están
// aisladas por organización y usuario (Fase 4); una memoria compartida entre usuarios del
// mismo tenant rompería ese aislamiento por la puerta de atrás: lo que el agente aprendiera
// de la conversación de una persona afloraría en la de otra.
//
// Por eso el alcance completo es `agentId + organizationId + userId`, y `userId` es
// OBLIGATORIO: no existe memoria organizacional compartida en esta fase.
model AgentMemory {
  id             String   @id @default(cuid())
  agentId        String
  organizationId String
  userId         String
  conversationId String? // null = memoria de largo plazo del usuario con este agente
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Sin estas dos claves ajenas, `organizationId` y `userId` serían columnas de filtrado sin
  // garantía: podrían desincronizarse de la organización real del agente.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Una clave de memoria identifica un hecho por usuario y agente: sin unicidad, recordar
  // algo dos veces crearía dos verdades simultáneas sin criterio de desempate.
  @@unique([agentId, userId, key])
  @@index([agentId, organizationId, userId])
}

// Groundwork de marketplace: una plantilla instalable de agente. No se construye el
// marketplace en esta fase, pero el modelo evita una migración disruptiva más adelante.
model AgentTemplate {
  id                  String                  @id @default(cuid())
  publisherOrgId      String? // null = plantilla first-party de BusinessBrain
  name                String
  description         String
  area                AgentArea
  visibility          AgentTemplateVisibility @default(PRIVATE)
  defaultSystemPrompt String
  defaultCapabilities Json                    @default("[]")
  defaultTools        Json                    @default("[]")
  version             Int                     @default(1)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  publisherOrg    Organization? @relation(fields: [publisherOrgId], references: [id], onDelete: SetNull)
  installedAgents Agent[]

  @@index([publisherOrgId])
  @@index([visibility])
}

// Configuración de proveedor de IA — decouplea el dominio de Anthropic/OpenAI/Gemini/Mistral/Ollama.
// organizationId = null representa un perfil de plataforma disponible como default para cualquier org.
model LlmProfile {
  id             String          @id @default(cuid())
  organizationId String?
  provider       LlmProviderName
  modelName      String // p.ej. "claude-sonnet-5", "gpt-4.1", "gemini-2.5-pro", "llama3:70b"
  params         Json            @default("{}") // temperature por defecto, max_tokens, top_p...
  apiKeyEnc      String? // API key propia del cliente (BYO key), cifrada; null = se usa la key de plataforma
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       Agent[]

  @@index([organizationId])
}

model Recommendation {
  id             String               @id @default(cuid())
  organizationId String
  agentId        String?
  area           AgentArea?
  title          String
  description    String
  priority       Int                  @default(0)
  status         RecommendationStatus @default(NEW)
  createdAt      DateTime             @default(now())

  // ── Quien resolvio y cuando (subfase 5.8) ───────────────────────────────
  // Aceptar o descartar una Recommendation es una DECISION HUMANA, no un cambio de estado
  // administrativo. Sin `resolvedById` la traza quedaba coja: se sabia cuando se resolvio
  // pero no quien lo decidio, y una propuesta que "requiere aprobacion explicita" (§11) sin
  // aprobador registrado no es auditable.
  // `SetNull` al borrar el usuario: la decision sobrevive a la baja de quien la tomo, igual
  // que un `Agent` desactivado conserva la trazabilidad de lo que produjo.
  resolvedById String?
  resolvedAt   DateTime?

  // Quien REDACTO la propuesta. `null` = la propuso BusinessBrain desde una conclusion; con
  // valor, la escribio esa persona escalando manualmente. Una PYME tiene que poder distinguir
  // si detras hay alguien de su empresa o es el sistema quien lo sugiere: no son lo mismo a la
  // hora de decidir. Mismo patron y misma semantica que `resolvedById`.
  createdById  String?

  // ── Contrato del Principio de Evolucion Asistida ────────────────────────
  // BUSINESSBRAIN_MIGRATION_PLAN.md §3.2 exige SEIS puntos en toda propuesta. Hasta esta
  // migracion solo cabian como texto libre en `description`, lo que contradecia la
  // exigencia de estructura. Cierra el bloqueante documentado de la subfase 3.5.
  detected        String? // que se ha detectado
  justification   String? // por que se considera una mejora
  estimatedImpact String? // impacto esperado
  advantages      String? // ventajas
  drawbacks       String? // inconvenientes
  affectedAreas   String? // que partes del sistema se verian afectadas
  // NUNCA se omite: si el cambio no requiere migracion, se completa explicitamente como
  // "no aplica", en vez de dejarse en blanco (§3.2).
  migrationPlan   String?

  // ── Trazabilidad hasta la comprension que la origino ────────────────────
  // Sin esta referencia es imposible saber si una recomendacion pendiente se apoya en
  // comprension que ya colapso (UNDERSTANDING_ENGINE_DESIGN.md §21, hallazgo 12).
  sourceInsightId String?

  // Alcance derivado heredado del Insight de origen (§3.4, §3.8). Sin el, escalar seria una
  // via de blanqueo: convertiria una conclusion de evidencia restringida en una entidad sin
  // ninguna acotacion.
  effectiveCollectionScope String[] @default([])

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent         Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sourceInsight Insight?     @relation(fields: [sourceInsightId], references: [id], onDelete: SetNull)
  resolvedBy    User?        @relation("RecommendationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("RecommendationAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sourceInsightId])
  @@index([resolvedById])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────
// Automatizaciones
// ─────────────────────────────────────────────────────────────────────────

model Automation {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  triggerType    AutomationTriggerType
  triggerConfig  Json // { cron: "0 8 * * 1" } o { event: "document.indexed" }
  actions        Json // pasos ordenados: [{ type, config }, ...]
  status         AutomationStatus      @default(ACTIVE)
  lastRunAt      DateTime?
  // Proximo disparo previsto, calculado al crear/modificar y al terminar cada ejecucion.
  //
  // Existe para que reclamar lo vencido sea una sola escritura condicional en Postgres:
  // varias instancias del backend compiten por la misma fila y solo una gana, sin cerrojo
  // aplicativo. Calcularlo en cada tic evaluando cron sobre `lastRunAt` habria dejado la
  // decision en memoria de cada proceso, y dos procesos habrian disparado lo mismo.
  //
  // Nulo cuando la automatizacion no es programada o esta pausada: lo que no tiene fecha no
  // se reclama nunca.
  nextRunAt      DateTime?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId])
  // Sostiene el barrido de vencidas: se consulta por fecha y estado, nunca por organizacion.
  @@index([nextRunAt, status])
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  status       RunStatus @default(PENDING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  logs         Json      @default("[]")
  error        String?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Informes
// ─────────────────────────────────────────────────────────────────────────

model Report {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  format         ReportFormat @default(PDF)
  template       Json // definición de secciones/queries del informe
  schedule       Json? // cron opcional para generación periódica
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         ReportRun[]

  @@index([organizationId])
}

model ReportRun {
  id          String    @id @default(cuid())
  reportId    String
  status      RunStatus @default(PENDING)
  fileUrl     String?
  generatedAt DateTime  @default(now())
  error       String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ─────────────────────────────────────────────────────────────────────────
// Integraciones externas
// ─────────────────────────────────────────────────────────────────────────

model Integration {
  id              String              @id @default(cuid())
  organizationId  String
  provider        IntegrationProvider
  status          ConnectionStatus    @default(PENDING)
  accessTokenEnc  String?
  refreshTokenEnc String?
  scope           String?
  expiresAt       DateTime?
  // Cuenta externa a la que quedó conectada, en texto legible. Es identidad de la CONEXIÓN,
  // para que un administrador sepa qué buzón alimenta al sistema y pueda auditarlo: no se
  // indexa ni se recupera, al contrario que el contenido que trae.
  accountLabel    String?
  connectedById   String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeSources KnowledgeSource[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notificaciones, auditoría, acceso API, uso/facturación
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String?
  type           NotificationType @default(INFO)
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String // "user.banned", "agent.created", "data_source.connected", ...
  targetType     String?
  targetId       String?
  metadata       Json     @default("{}")
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  hashedKey      String
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String // "ai_tokens" | "documents_indexed" | "agent_runs" | ...
  value          Int
  periodStart    DateTime
  periodEnd      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Una fila por empresa, metrica y periodo. Sin esto, dos vectorizaciones simultaneas de la
  /// misma empresa crearian dos filas del mismo dia y el tope se contaria por la mitad.
  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric, periodStart])
}

// Nodo de la taxonomía jerárquica de negocio — KNOWLEDGE_ENGINE_DESIGN.md §9, §3.8.
// Cada organización tiene su propio árbol, sembrado con un conjunto de categorías de
// fábrica alineadas a las áreas de negocio de los agentes. Una organización puede
// EXTENDER ese árbol con subcategorías propias, pero no reemplazar la raíz común:
// mantenerla permite comparar y agrupar conocimiento a nivel de producto sin depender
// de que cada tenant nombre las cosas igual (§9, "Categorías y taxonomía").
model TaxonomyNode {
  id             String @id @default(cuid())
  organizationId String

  // Clave estable dentro de la organización (p. ej. "hr.policies.vacation"). El path
  // completo hace explícita la jerarquía y permite resolver ancestros sin recorrer el
  // árbol: la pertenencia a un nodo implica pertenencia a todos sus ancestros (§9).
  key      String
  label    String
  parentId String?

  // Área de negocio que este nodo aporta a los ítems clasificados bajo él. Se hereda del
  // ancestro raíz; los nodos de fábrica la fijan y las subcategorías propias la heredan.
  businessArea AgentArea

  // Los nodos de fábrica no se pueden borrar ni renombrar: son la raíz común compartida.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         TaxonomyNode?   @relation("TaxonomyHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       TaxonomyNode[]  @relation("TaxonomyHierarchy")
  knowledgeItems KnowledgeItem[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([parentId])
}

// Agrupa KnowledgeItem que describen el MISMO HECHO de negocio y determina cuál prevalece
// — KNOWLEDGE_ENGINE_DESIGN.md §3.10, §10.
//
// Eje ORTOGONAL al versionado (§3.7): el linaje resuelve "cuál es la última versión de este
// documento"; la canonicalización resuelve "cuál es la verdad cuando el CRM dice una cosa y
// el ERP dice otra". Nunca se mezclan ni comparten aristas.
model CanonicalKnowledgeEntity {
  id             String @id @default(cuid())
  organizationId String

  status CanonicalResolutionStatus @default(IN_CONFLICT)

  // Miembro actualmente canónico. Nulo mientras el grupo esté en conflicto: la recuperación
  // puede entonces devolver varios candidatos con señal explícita de desacuerdo, en vez de
  // fingir una certeza que no existe (§10).
  winnerKnowledgeItemId String?

  // Margen con el que ganó, para poder explicar la decisión sin recalcularla.
  winnerMargin Float?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  winner       KnowledgeItem?       @relation("CanonicalWinner", fields: [winnerKnowledgeItemId], references: [id], onDelete: SetNull)
  candidates   CanonicalCandidate[]
  decisions    CanonicalDecision[]

  @@index([organizationId])
  @@index([organizationId, status])
}

// Pertenencia de un KnowledgeItem a un grupo canónico. Un ítem no canónico permanece
// consultable pero excluido de recuperación por defecto (§10, §13 paso 4).
model CanonicalCandidate {
  id                         String @id @default(cuid())
  canonicalKnowledgeEntityId String
  knowledgeItemId            String

  origin  CanonicalCandidateOrigin
  addedAt DateTime                 @default(now())

  canonicalKnowledgeEntity CanonicalKnowledgeEntity @relation(fields: [canonicalKnowledgeEntityId], references: [id], onDelete: Cascade)
  knowledgeItem            KnowledgeItem            @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  // Un KnowledgeItem no puede pertenecer dos veces al mismo grupo.
  @@unique([canonicalKnowledgeEntityId, knowledgeItemId])
  @@index([knowledgeItemId])
}

// Historial de qué fue canónico antes y por qué cambió (§3.10). Solo-anexado: la decisión
// de canonicidad es auditable, igual que la confianza.
model CanonicalDecision {
  id                         String @id @default(cuid())
  canonicalKnowledgeEntityId String

  previousWinnerId String?
  newWinnerId      String?
  status           CanonicalResolutionStatus
  // Ranking completo evaluado y el porqué de la decisión.
  rationale        Json
  actorUserId      String?
  createdAt        DateTime                  @default(now())

  canonicalKnowledgeEntity CanonicalKnowledgeEntity @relation(fields: [canonicalKnowledgeEntityId], references: [id], onDelete: Cascade)

  @@index([canonicalKnowledgeEntityId, createdAt])
}

// Algo que la organizacion ha declarado que le importa: una meta, un KPI, una prioridad,
// una restriccion — UNDERSTANDING_ENGINE_DESIGN.md §3.6, subfase 3.2.
//
// Es la entidad que ancla RISK y OPPORTUNITY a algo verificable en vez de a una estimacion
// libre del sistema. El Understanding Engine posee su ciclo de vida OPERATIVO (declaracion,
// inferencia de candidatos, confirmacion) pero NUNCA la decision de que objetivo es valido:
// esa decision es siempre humana (§1.4).
model BusinessObjective {
  id             String @id @default(cuid())
  organizationId String

  statement   String // "el churn debe mantenerse por debajo del 5%"
  description String?

  status BusinessObjectiveStatus @default(INFERRED)
  origin BusinessObjectiveOrigin

  // Confianza reducida para un candidato inferido; plena para una declaracion humana.
  confidence Float @default(0.5)

  // Version anterior de la cadena UPDATES (§3.6). El objetivo no se edita en sitio: se
  // versiona, preservando el historial de que le importaba a la empresa en cada momento.
  supersedesObjectiveId String? @unique

  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supersedes   BusinessObjective?     @relation("ObjectiveVersioning", fields: [supersedesObjectiveId], references: [id], onDelete: SetNull)
  supersededBy BusinessObjective?     @relation("ObjectiveVersioning")
  insightLinks InsightObjectiveLink[]

  @@index([organizationId])
  @@index([organizationId, status])
}

// Ancla de negocio de un Insight — UNDERSTANDING_ENGINE_DESIGN.md §3.8.
//
// Relacion DELIBERADAMENTE distinta de InsightEvidence: la evidencia sostiene que un hecho
// existe; este vinculo justifica por que ese hecho, ya sostenido por su propia evidencia,
// merece el juicio de valor de riesgo u oportunidad. Mezclarlas difuminaria exactamente la
// distincion que motivo introducir BusinessObjective.
model InsightObjectiveLink {
  id                  String @id @default(cuid())
  insightId           String
  businessObjectiveId String

  createdAt DateTime @default(now())

  insight           Insight           @relation(fields: [insightId], references: [id], onDelete: Cascade)
  businessObjective BusinessObjective @relation(fields: [businessObjectiveId], references: [id], onDelete: Restrict)

  @@unique([insightId, businessObjectiveId])
  @@index([businessObjectiveId])
}

// Tipo de curacion humana sobre un Insight — UNDERSTANDING_ENGINE_DESIGN.md §3.7.
enum InsightFeedbackType {
  CONFIRMATION // una persona valida el hallazgo
  DISMISSAL // una persona lo rechaza
  CORRECTION // una persona corrige su contenido o su clasificacion
  REVOCATION // se revoca una curacion anterior; NO borra el registro previo
}

// Curacion humana sobre un Insight — UNDERSTANDING_ENGINE_DESIGN.md §3.7.
//
// Una vez registrada tiene PRIORIDAD sobre cualquier recalculo automatico posterior hasta
// que se revoca explicitamente. Registro de solo-anexado: revocar crea una entrada nueva,
// nunca borra la anterior — mismo principio de no sobrescribir que rige todo el sistema.
model InsightFeedback {
  id             String @id @default(cuid())
  organizationId String
  insightId      String

  type              InsightFeedbackType
  comment           String?
  // Entrada que esta revocacion deja sin efecto (solo para type = REVOCATION).
  revokesFeedbackId String?             @unique

  actorUserId String
  createdAt   DateTime @default(now())

  insight   Insight          @relation(fields: [insightId], references: [id], onDelete: Cascade)
  revokes   InsightFeedback? @relation("FeedbackRevocation", fields: [revokesFeedbackId], references: [id], onDelete: SetNull)
  revokedBy InsightFeedback? @relation("FeedbackRevocation")

  @@index([insightId, createdAt])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Understanding Engine — Fase 3, subfase 3.1
// Especificación: docs/UNDERSTANDING_ENGINE_DESIGN.md (🧊 congelada v1.0)
// ─────────────────────────────────────────────────────────────────────────

// Qué disparó una ejecución de razonamiento — UNDERSTANDING_ENGINE_DESIGN.md §3.1, §4.
enum AnalysisRunTrigger {
  PERIODIC_SWEEP // barrido periódico sobre organizaciones con ReasoningProfile habilitado
  KNOWLEDGE_SIGNAL // evento del Knowledge Engine observado vía KnowledgeSignalsPort (§13)
  MANUAL // ejecución solicitada explícitamente
}

// Ciclo de vida de un AnalysisRun — §3.1. Equivalente exacto de IngestionJobStatus.
enum AnalysisRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED // total o parcial: un fallo parcial registra qué falló sin descartar lo procesado
}

// Tipos de Insight — §3.4. Regla de clasificación: todo tipo nuevo debe declarar
// explícitamente si exige un BusinessObjective CONFIRMED vinculado (§8). RISK y
// OPPORTUNITY lo exigen; PATTERN y ANOMALY no (§7).
enum InsightType {
  PATTERN
  ANOMALY
  RISK
  OPPORTUNITY
}

// Estatus EPISTÉMICO de un Insight — §5. Describe qué sabemos de la validez de la
// conclusión, nunca la frescura de su cómputo: esa es EvidenceFreshness, una proyección
// derivada en lectura (§3.4) que deliberadamente NO se persiste como estado.
// Terminales: SUPERSEDED, DISCARDED, EXPIRED. Todo estado nuevo debe clasificarse
// explícitamente como activo o terminal, verificado en CI — nunca por omisión.
enum InsightStatus {
  CANDIDATE // generado dentro de un AnalysisRun, aún no persistido como conocimiento vivo
  ACTIVE // único estado activo persistido
  SUPERSEDED // un Insight posterior con la misma subjectIdentity lo reemplazó
  DISCARDED // curación humana (§3.7, subfase 3.5)
  EXPIRED // un recálculo confirmó que el asunto ya no se sostiene
}

// Rol que juega una pieza de evidencia en el razonamiento — §3.5.
enum InsightEvidenceRole {
  BASELINE
  DEVIATION
  CORROBORATION
  CONTRADICTION
}

// Naturaleza de la evidencia referenciada — §3.5. DERIVED_INSIGHT nunca es evidencia
// primaria y degrada confianza en cada eslabón (§9).
enum InsightEvidenceKind {
  KNOWLEDGE_ITEM
  KNOWLEDGE_CHUNK
  CANONICAL_ENTITY // Canonical Knowledge Entity — modelado en subfase 2.5
  DERIVED_INSIGHT
}

// Registra una única ejecución del pipeline de razonamiento para una organización — §3.1.
// Varios AnalysisRun simultáneos por organización son legítimos y NO se serializan: la
// corrección bajo concurrencia se obtiene de la unicidad de subjectIdentity y de que los
// baselines sean derivados, no de restringir la ejecución (§3.1, §6, §12).
model AnalysisRun {
  id             String @id @default(cuid())
  organizationId String

  trigger AnalysisRunTrigger
  status  AnalysisRunStatus  @default(PENDING)

  // Estadísticas de cierre (§4). Nunca se modifican tras terminar: registro histórico inmutable.
  candidatesGenerated Int @default(0)
  insightsCreated     Int @default(0)
  insightsSuperseded  Int @default(0)
  insightsQueued      Int @default(0) // encolados para recálculo proactivo (§5)

  error       String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insights     Insight[]

  @@index([organizationId])
  @@index([organizationId, status])
}

// Unidad atómica de comprensión derivada — §3.4.
model Insight {
  id             String @id @default(cuid())
  organizationId String
  analysisRunId  String

  // Identidad de sujeto (§3.4): declara DE QUÉ ASUNTO trata, y sostiene supersesión,
  // corroboración, contradicción, agrupación e idempotencia. Es una declaración
  // epistémica (continuidad entre afirmaciones), nunca una detección de la realidad.
  // Ante duda, la estrategia acuña una identidad nueva: JAMÁS fusiona por aproximación.
  // El tipo nunca forma parte de la identidad — un mismo sujeto pasa de ANOMALY a RISK
  // cuando aparece un BusinessObjective CONFIRMED que lo hace relevante (§8).
  subjectIdentity String

  type    InsightType
  summary String // resumen legible de la conclusión
  status  InsightStatus @default(CANDIDATE)

  // Mecanismo y versión que lo generó (§10) — obligatorio para trazabilidad, mismo
  // criterio que un Embedding registra su modelo (KNOWLEDGE_ENGINE_DESIGN.md §3.11).
  strategyKey     String
  strategyVersion String

  // Traza de razonamiento estructurada (§10), obligatoria y nunca texto libre sin
  // estructura. Su forma depende de la categoría de estrategia (§6).
  reasoningTrace Json

  // Confianza compuesta (§9): mín(confianza de evidencia primaria) × fiabilidad de la
  // estrategia. BusinessObjective NUNCA participa en este cálculo: es un gate booleano.
  confidence Float

  // Cierre transitivo de la evidencia (§3.4): conjunto plano e INMUTABLE de todo lo que
  // sostiene el razonamiento — evidencia de conocimiento y los Insight citados. Es
  // función pura de un grafo inmutable y acíclico, por eso puede materializarse. Sobre
  // él se proyectan en lectura EffectiveCollectionScope y EvidenceFreshness, que nunca
  // se persisten como fuente de verdad.
  transitiveEvidenceClosure Json

  supersedesInsightId String? @unique

  // Momento del ultimo calculo de confianza. Base del decaimiento (§9) Y de la frescura
  // (§3.4): la evidencia que haya cambiado DESPUES de este instante hace que el Insight se
  // lea como no fresco, sin depender de que ninguna cascada asincrona llegue.
  confidenceComputedAt DateTime @default(now())

  createdAt DateTime @default(now())

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  analysisRun     AnalysisRun            @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  supersedes      Insight?               @relation("InsightSupersession", fields: [supersedesInsightId], references: [id], onDelete: SetNull)
  supersededBy    Insight?               @relation("InsightSupersession")
  evidence        InsightEvidence[]
  citedAsEvidence InsightEvidence[]      @relation("InsightAsEvidence")
  objectiveLinks  InsightObjectiveLink[]
  feedback        InsightFeedback[]
  recommendations Recommendation[]

  @@index([organizationId])
  @@index([analysisRunId])
  @@index([organizationId, status])
  // La unicidad real es PARCIAL — (organizationId, subjectIdentity) excluyendo estados
  // terminales — y no es expresable en Prisma: se crea a mano en la migración SQL.
  @@index([organizationId, subjectIdentity])
}

// Trazabilidad entre un Insight y lo que lo sostiene — §3.5. Inmutable: el grafo de
// evidencia es acíclico por construcción (solo referencia Insight YA persistidos) y
// ortogonal al linaje de supersesión; ambos nunca se recorren juntos.
model InsightEvidence {
  id        String @id @default(cuid())
  insightId String

  kind InsightEvidenceKind
  role InsightEvidenceRole

  // Referencia polimórfica a la pieza de evidencia. Exactamente una está informada,
  // según `kind` — validado en dominio y por restricción CHECK en la migración.
  knowledgeItemId  String?
  knowledgeChunkId String?
  derivedInsightId String?

  createdAt DateTime @default(now())

  insight        Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  derivedInsight Insight? @relation("InsightAsEvidence", fields: [derivedInsightId], references: [id], onDelete: Restrict)

  @@index([insightId])
  @@index([knowledgeItemId])
  @@index([derivedInsightId])
}
